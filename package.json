{
  "name": "eve-log-analyzer-app",
  "version": "1.0.0",
  "description": "EVE Online Log Analyzer Desktop Application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "keywords": [
    "electron",
    "eve-online",
    "log-analyzer"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.eveloganalyzer.app",
    "productName": "EVE Log Analyzer",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "deb",
      "icon": "build/icon.png"
    }
  }
}